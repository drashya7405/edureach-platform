# Client Environment Variables

# Backend API base URL (Optional in development - Vite proxies /api to VITE_SERVER_URL by default)
# Production example: https://your-server-domain.vercel.app/api
VITE_API_URL=

# Backend server address for Vite proxy during local development
# Default: http://localhost:3001
VITE_SERVER_URL=http://localhost:3001
