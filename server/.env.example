# Server Environment Variables

# Port to listen on (Default: 3001)
PORT=3001

# Allowed frontend origin(s) for CORS (comma-separated if multiple)
# Local: http://localhost:5173
# Production: https://your-frontend-app.vercel.app
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (Mongoose + Vector Search)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/edureach_db?retryWrites=true&w=majority
MONGODB_URI=

# JWT secret key used to sign and verify authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# JWT token expiration time (e.g., 7d, 24h, 30m)
JWT_EXPIRES_IN=7d

# Google Gemini API key for Chatbot and Embeddings
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Gemini Chat Model (Default: gemini-1.5-flash)
GEMINI_CHAT_MODEL=gemini-1.5-flash

# Gemini Embedding Model for RAG vector search (Default: text-embedding-004)
GEMINI_EMBEDDING_MODEL=text-embedding-004
